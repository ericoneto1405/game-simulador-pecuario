[sub_resource type="Shader" id="ShaderRiverLevel"]
code = "shader_type canvas_item;\n\nuniform float water_level : hint_range(0.0, 1.0) = 0.65;\n\nvoid fragment() {\n\tvec4 river = texture(TEXTURE, UV);\n\tfloat threshold = mix(0.96, 0.08, water_level);\n\tfloat coverage = smoothstep(threshold - 0.08, threshold + 0.08, river.a);\n\tfloat level_alpha = mix(0.55, 0.95, water_level);\n\tCOLOR = vec4(river.rgb, coverage * level_alpha);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterialRiverLevel"]
shader = SubResource("ShaderRiverLevel")
shader_parameter/water_level = 0.65

